# =============================================================================
# arch-netinstall — configuração
# Edite este arquivo. Ele é lido pelo install.sh e copiado para dentro do
# sistema instalado em /root/netinstall/config.env (histórico do que foi usado).
# =============================================================================

# --- identidade -------------------------------------------------------------
USERNAME="rocha"
USER_SHELL="/bin/bash"
HOSTNAME="bot"
# Grupos extras do usuário (wheel é sempre adicionado).
USER_GROUPS="wheel,docker,rfkill,autologin"

# --- localização ------------------------------------------------------------
TIMEZONE="America/Sao_Paulo"
LOCALE="pt_BR.UTF-8"
KEYMAP="br-abnt2"
X11_LAYOUT="br"
X11_MODEL="abnt2"

# --- disco ------------------------------------------------------------------
# Vazio: obrigatório passar --disk /dev/sdX na linha de comando.
DISK=""
# Tamanhos das partições (mesmo layout da máquina de origem).
ESP_SIZE="2G"
SWAP_SIZE="8G"
# Rótulos
LABEL_ESP="EFI"
LABEL_ROOT="root"
LABEL_SWAP="swap"
# Tamanho mínimo aceitável do disco alvo, em GB.
DISK_MIN_GB=20

# --- boot -------------------------------------------------------------------
# kernel: both | lts | stable
KERNEL="both"
# ESP montada em /boot (padrão Arch + systemd-boot + mkinitcpio).
BOOTLOADER="systemd-boot"
BOOT_TIMEOUT=3
BOOT_DEFAULT="arch-lts.conf"
# Espelhos usados no ranking do reflector.
MIRROR_COUNTRIES="Brazil,Chile,Argentina,United States"
MIRROR_LATEST=20

# --- desktop ----------------------------------------------------------------
DESKTOP="xfce-i3"
DISPLAY_MANAGER="lightdm"
SESSION="i3"
AUTOLOGIN="yes"
# Instala firefox/chromium/mpv/xed/galculator/meld/xarchiver/scrcpy etc.
DESKTOP_APPS="yes"

# --- extras -----------------------------------------------------------------
# Copia os arquivos de dotfiles/ para o home do usuário (com backup .bak).
INSTALL_DOTFILES="yes"
# Repositórios clonados no fim da instalação (separados por espaço).
# Use HTTPS (sem chave SSH na instalação nova); ajuste o remoto depois com:
#   git remote set-url origin git@github.com:usuario/repo.git
REPOS="https://github.com/edisrocha/mv3.git"
# AUR: yay é sempre instalado (necessário para os pacotes de aur.txt).
INSTALL_AUR="yes"
# git identity (vazio = não mexe)
GIT_NAME=""
GIT_EMAIL=""
# /tmp como tmpfs no fstab (como na máquina de origem)
TMP_TMPFS="yes"
# zram (zram-generator) — na origem existe config mas com swap em disco
ZRAM="yes"

# --- comportamento ----------------------------------------------------------
# Logs também vão para $USB_DIR/logs quando o script roda do pendrive.
LOG_TO_USB="yes"
# Retry por pacote no pacstrap
PACSTRAP_RETRIES=3
